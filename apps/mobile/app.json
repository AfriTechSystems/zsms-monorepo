{
  "expo": {
    "name": "ZSMS",
    "slug": "zsms",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "zm.co.zsms.app"
    },
    "android": {
      "package": "zm.co.zsms.app",
      "adaptiveIcon": {
        "backgroundColor": "#1D4ED8"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-notifications"
    ],
    "scheme": "zsms",
    "experiments": {
      "typedRoutes": true
    }
  }
}
