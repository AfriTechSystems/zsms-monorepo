# The ZSMS API the phone talks to.
#
# NEVER `localhost` on a device: on a phone that is the phone. `npm run dev` prints the
# LAN address of the machine running the web app — use that, with the port.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Clerk's PUBLISHABLE key, which is safe in a client bundle by design. The secret key
# never appears here and never reaches the app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
