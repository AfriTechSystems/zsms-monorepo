  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*[Ss]upabase.*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-supabase-sql.js",
            "timeout": 20,
            "statusMessage": "Checking SQL for destructive statements"
          }
        ]
      }
    ]
  }
