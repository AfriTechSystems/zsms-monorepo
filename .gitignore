# === Secrets and credentials ===
# CONVENTIONS.md prohibition #2: real credentials are never committed.
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
*.pem
*.key

# === Claude Code ===
# Personal permission overrides stay local; .claude/settings.json (shared) is tracked.
.claude/settings.local.json

# === Dependencies ===
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# === Turborepo ===
.turbo/
out/

# === Next.js ===
.next/
next-env.d.ts
.vercel/

# === Build output ===
dist/
build/
*.tsbuildinfo

# === Expo / React Native ===
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.mobileprovision
*.orig.*

# === Supabase ===
# Local stack state and generated temp files. Migrations and config ARE tracked.
supabase/.branches/
supabase/.temp/

# === Testing and coverage ===
coverage/
.nyc_output/
*.lcov

# === Logs ===
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# === Editors ===
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# === OS ===
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# === Reference documents (not source artifacts) ===
# Working/reference material kept alongside the repo but not part of the build.
ZSMS_Master_Tracker.*

# === Office lock files ===
# Word/Excel leave these behind when a document is open.
~$*.docx
~$*.xlsx
~$*.pptx

# Scratch space for adapted test runs and rendered-output checks. Never committed.
.scratch/
